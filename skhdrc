# Keep the established Option-based shortcuts while yabai manages native Spaces.

:: resize @
:: launch @
:: service @

# Spotify controls on Fn + F7-F12. The unmodified media-key events are left to
# macOS for system-wide playback and volume control.
f7         : $HOME/.config/aerospace/scripts/spotify/prev.sh
f8         : $HOME/.config/aerospace/scripts/spotify/playpause.sh
f9         : $HOME/.config/aerospace/scripts/spotify/next.sh
f10        : $HOME/.config/aerospace/scripts/spotify/mute.sh
f11        : $HOME/.config/aerospace/scripts/spotify/volumedown.sh
f12        : $HOME/.config/aerospace/scripts/spotify/volumeup.sh

# Focus and move windows using the real macOS display geometry.
alt - left  : $HOME/.config/yabai/scripts/focus-direction.sh west
alt - down  : $HOME/.config/yabai/scripts/focus-direction.sh south
alt - up    : $HOME/.config/yabai/scripts/focus-direction.sh north
alt - right : $HOME/.config/yabai/scripts/focus-direction.sh east
alt - h     : $HOME/.config/yabai/scripts/focus-direction.sh west
alt - j     : $HOME/.config/yabai/scripts/focus-direction.sh south
alt - k     : $HOME/.config/yabai/scripts/focus-direction.sh north
alt - l     : $HOME/.config/yabai/scripts/focus-direction.sh east

shift + alt - left  : $HOME/.config/yabai/scripts/move-direction.sh west
shift + alt - down  : $HOME/.config/yabai/scripts/move-direction.sh south
shift + alt - up    : $HOME/.config/yabai/scripts/move-direction.sh north
shift + alt - right : $HOME/.config/yabai/scripts/move-direction.sh east
shift + alt - h     : $HOME/.config/yabai/scripts/move-direction.sh west
shift + alt - j     : $HOME/.config/yabai/scripts/move-direction.sh south
shift + alt - k     : $HOME/.config/yabai/scripts/move-direction.sh north
shift + alt - l     : $HOME/.config/yabai/scripts/move-direction.sh east

# Layout and sizing.
alt - 0x2C         : $HOME/.config/yabai/scripts/toggle-tiles.sh
alt - 0x2B         : /opt/homebrew/bin/yabai -m space --layout stack
alt - space        : /opt/homebrew/bin/yabai -m window --toggle float
shift + alt - f    : /opt/homebrew/bin/yabai -m window --toggle float
alt - f            : /opt/homebrew/bin/yabai -m window --toggle zoom-fullscreen
alt - 0x1B         : /opt/homebrew/bin/yabai -m window --ratio rel:-0.05
alt - 0x18         : /opt/homebrew/bin/yabai -m window --ratio rel:0.05
shift + alt - e    : /opt/homebrew/bin/yabai -m space --balance
alt - r            ; resize

resize < h         : /opt/homebrew/bin/yabai -m window --resize right:-40:0
resize < left      : /opt/homebrew/bin/yabai -m window --resize right:-40:0
resize < l         : /opt/homebrew/bin/yabai -m window --resize right:40:0
resize < right     : /opt/homebrew/bin/yabai -m window --resize right:40:0
resize < k         : /opt/homebrew/bin/yabai -m window --resize top:0:40
resize < up        : /opt/homebrew/bin/yabai -m window --resize top:0:40
resize < j         : /opt/homebrew/bin/yabai -m window --resize bottom:0:40
resize < down      : /opt/homebrew/bin/yabai -m window --resize bottom:0:40
resize < 0x1B      : /opt/homebrew/bin/yabai -m window --ratio rel:-0.05
resize < 0x18      : /opt/homebrew/bin/yabai -m window --ratio rel:0.05
resize < b         : /opt/homebrew/bin/yabai -m space --balance
resize < return    ; default
resize < escape    ; default

# Native Spaces. Numeric-looking labels are prefixed with ws- to avoid index ambiguity.
alt - 1            : $HOME/.config/yabai/scripts/focus-space.sh 1
alt - 2            : $HOME/.config/yabai/scripts/focus-space.sh 2
alt - 3            : $HOME/.config/yabai/scripts/focus-space.sh 3
alt - 4            : $HOME/.config/yabai/scripts/focus-space.sh 4
alt - 5            : $HOME/.config/yabai/scripts/focus-space.sh 5
alt - 6            : $HOME/.config/yabai/scripts/focus-space.sh 6
alt - 7            : $HOME/.config/yabai/scripts/focus-space.sh 7
alt - 8            : $HOME/.config/yabai/scripts/focus-space.sh 8
alt - 9            : $HOME/.config/yabai/scripts/focus-space.sh 9
alt - 0            : $HOME/.config/yabai/scripts/focus-space.sh 0
alt - c            : $HOME/.config/yabai/scripts/focus-space.sh c
alt - o            : $HOME/.config/yabai/scripts/focus-space.sh o
alt - q            : $HOME/.config/yabai/scripts/focus-space.sh 0

shift + alt - 1    : $HOME/.config/yabai/scripts/move-window-to-space.sh 1
shift + alt - 2    : $HOME/.config/yabai/scripts/move-window-to-space.sh 2
shift + alt - 3    : $HOME/.config/yabai/scripts/move-window-to-space.sh 3
shift + alt - 4    : $HOME/.config/yabai/scripts/move-window-to-space.sh 4
shift + alt - 5    : $HOME/.config/yabai/scripts/move-window-to-space.sh 5
shift + alt - 6    : $HOME/.config/yabai/scripts/move-window-to-space.sh 6
shift + alt - 7    : $HOME/.config/yabai/scripts/move-window-to-space.sh 7
shift + alt - 8    : $HOME/.config/yabai/scripts/move-window-to-space.sh 8
shift + alt - 9    : $HOME/.config/yabai/scripts/move-window-to-space.sh 9
shift + alt - 0    : $HOME/.config/yabai/scripts/move-window-to-space.sh 0
shift + alt - c    : $HOME/.config/yabai/scripts/move-window-to-space.sh c
shift + alt - o    : $HOME/.config/yabai/scripts/move-window-to-space.sh o

alt - 0x32         : /opt/homebrew/bin/yabai -m space --focus recent
ctrl + alt - 0x32  : /opt/homebrew/bin/yabai -m window --focus recent
alt - 0x21         : $HOME/.config/yabai/scripts/focus-relative-space.sh prev
alt - 0x1E         : $HOME/.config/yabai/scripts/focus-relative-space.sh next
shift + alt - 0x21 : $HOME/.config/yabai/scripts/move-window-relative-space.sh prev
shift + alt - 0x1E : $HOME/.config/yabai/scripts/move-window-relative-space.sh next

# Browsers, window cycling, displays, and maintenance.
alt - b            : $HOME/.config/yabai/scripts/launch-app.sh 2 "Zen"
shift + alt - b    : $HOME/.config/yabai/scripts/launch-app.sh 8 "Google Chrome"
ctrl + alt - b     : $HOME/.config/yabai/scripts/launch-app.sh 8 "Brave Browser"
alt - tab          : $HOME/.config/yabai/scripts/focus-next-window.sh
alt - m            : /opt/homebrew/bin/yabai -m display --focus next
shift + alt - m    : $HOME/.config/yabai/scripts/move-window-next-display.sh
shift + alt - tab  : $HOME/.config/yabai/scripts/move-space-next-display.sh
shift + alt - r    : $HOME/.config/yabai/scripts/restart.sh
shift + alt - p    : $HOME/.config/yabai/scripts/privacy-screen-share.sh
shift + alt - a    : $HOME/.config/yabai/scripts/arrange-workspaces.sh
shift + alt - s    : $HOME/.config/yabai/scripts/open-shortcuts.sh
alt - return       : osascript -e 'tell application "Ghostty" to new window'
alt - 0x29         ; launch
shift + alt - 0x29 ; service

# One-shot application launcher mode. Escape is synthesized after each launch.
launch < z         : $HOME/.config/yabai/scripts/launch-app.sh 2 "Zen"; /opt/homebrew/bin/skhd -k "escape"
launch < c         : $HOME/.config/yabai/scripts/launch-app.sh 8 "Google Chrome"; /opt/homebrew/bin/skhd -k "escape"
launch < b         : $HOME/.config/yabai/scripts/launch-app.sh 8 "Brave Browser"; /opt/homebrew/bin/skhd -k "escape"
launch < g         : $HOME/.config/yabai/scripts/launch-app.sh 1 "Ghostty"; /opt/homebrew/bin/skhd -k "escape"
launch < v         : $HOME/.config/yabai/scripts/launch-app.sh 1 "Visual Studio Code"; /opt/homebrew/bin/skhd -k "escape"
launch < a         : $HOME/.config/yabai/scripts/launch-app.sh 3 "ChatGPT"; /opt/homebrew/bin/skhd -k "escape"
launch < x         : $HOME/.config/yabai/scripts/launch-app.sh 3 "Codex"; /opt/homebrew/bin/skhd -k "escape"
launch < d         : $HOME/.config/yabai/scripts/launch-app.sh 4 "Discord"; /opt/homebrew/bin/skhd -k "escape"
launch < w         : $HOME/.config/yabai/scripts/launch-app.sh 6 "WhatsApp"; /opt/homebrew/bin/skhd -k "escape"
launch < m         : $HOME/.config/yabai/scripts/launch-app.sh 4 "Mail"; /opt/homebrew/bin/skhd -k "escape"
launch < n         : $HOME/.config/yabai/scripts/launch-app.sh 7 "Notes"; /opt/homebrew/bin/skhd -k "escape"
launch < s         : $HOME/.config/yabai/scripts/launch-app.sh 5 "Spotify"; /opt/homebrew/bin/skhd -k "escape"
launch < o         : $HOME/.config/yabai/scripts/launch-app.sh o "OBS"; /opt/homebrew/bin/skhd -k "escape"
launch < f         : $HOME/.config/yabai/scripts/launch-app.sh 0 "Finder"; /opt/homebrew/bin/skhd -k "escape"
launch < escape    ; default

# Service mode.
service < r        : /opt/homebrew/bin/yabai -m space --layout bsp; /opt/homebrew/bin/yabai -m space --balance; /opt/homebrew/bin/skhd -k "escape"
service < f        : /opt/homebrew/bin/yabai -m window --toggle float; /opt/homebrew/bin/skhd -k "escape"
service < b        : /opt/homebrew/bin/yabai -m space --balance; /opt/homebrew/bin/skhd -k "escape"
service < c        : /opt/homebrew/bin/yabai -m window --close; /opt/homebrew/bin/skhd -k "escape"
service < backspace : $HOME/.config/yabai/scripts/close-others.sh; /opt/homebrew/bin/skhd -k "escape"
service < shift + alt - h : /opt/homebrew/bin/yabai -m window --insert west; /opt/homebrew/bin/skhd -k "escape"
service < shift + alt - j : /opt/homebrew/bin/yabai -m window --insert south; /opt/homebrew/bin/skhd -k "escape"
service < shift + alt - k : /opt/homebrew/bin/yabai -m window --insert north; /opt/homebrew/bin/skhd -k "escape"
service < shift + alt - l : /opt/homebrew/bin/yabai -m window --insert east; /opt/homebrew/bin/skhd -k "escape"
service < escape   ; default
service < return   ; default
