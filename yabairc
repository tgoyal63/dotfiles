#!/usr/bin/env sh

# yabai configuration for native macOS Spaces. The helper scripts are linked by
# scripts/link-configs.sh so this file remains portable when symlinked.
yabai -m config                                 \
  mouse_follows_focus          on               \
  focus_follows_mouse          off              \
  display_arrangement_order    default          \
  window_origin_display        default          \
  window_placement             second_child     \
  window_insertion_point       focused          \
  window_zoom_persist          on               \
  split_ratio                  0.50             \
  split_type                   auto             \
  auto_balance                 off              \
  top_padding                  0                \
  bottom_padding               0                \
  left_padding                 0                \
  right_padding                0                \
  window_gap                   0                \
  layout                       bsp              \
  mouse_modifier               alt              \
  mouse_action1                move             \
  mouse_action2                resize           \
  mouse_drop_action            swap

yabai_scripts="${XDG_CONFIG_HOME:-$HOME/.config}/yabai/scripts"

# Register recovery even if the initial load fails or replaces the payload and
# restarts Dock. Successful recovery must also leave the fallback animation path.
yabai -m signal --add \
  label=reload-scripting-addition \
  event=dock_did_restart \
  action="sudo -n /opt/homebrew/bin/yabai --load-sa && /opt/homebrew/bin/yabai -m config skip_window_focus_animation off"

if [ -d /Library/ScriptingAdditions/yabai.osax ] && sudo -n /opt/homebrew/bin/yabai --load-sa; then
  yabai -m config skip_window_focus_animation off
else
  printf '%s\n' 'yabai: scripting addition unavailable; native Space switching may be slow.' >&2
  yabai -m config skip_window_focus_animation on
fi

"$yabai_scripts/startup.sh" >>/tmp/yabai-startup_"$USER".log 2>&1 &

unset yabai_scripts
